{"code":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"utf-8\" name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\r\n<title>tB - NET</title>\r\n<style>\r\n\r\n\r\n    .pointer{cursor:pointer;}\r\n\r\n    .mainTitleClass {\r\n        display:flex;\r\n        font-size: 1.7rem;\r\n        margin-top: 0.3rem;\r\n        margin-bottom: 0.3rem;\r\n        margin-left: 0;\r\n        margin-right: 0;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .autoGeneratedBooksGroupClass {\r\n        display:flex;\r\n        flex-wrap: nowrap;\r\n        flex-direction: row;\r\n        font-size: 1.2rem;\r\n        margin-top: 0rem;\r\n        margin-bottom: 0.7rem;\r\n        margin-left: 0;\r\n        margin-right: 0;\r\n        font-weight: bold;\r\n        line-height:150%;\r\n    }\r\n    #textSizeSelectorButtons{\r\n        margin-left: auto;\r\n        margin-right: 1rem;\r\n    }\r\n\r\n    .buttonGroup{\r\n        display:flex;\r\n        margin-top: 0.5rem;\r\n        margin-bottom: 1rem;\r\n        margin-left: 0;\r\n        margin-right: 0;\r\n        font-weight: bold;\r\n        text-align: center;\r\n        flex-wrap: nowrap;\r\n        width:100%;\r\n        height:2.3rem;\r\n    }\r\n    .lowerButtonGroup{\r\n        display:flex;\r\n        margin-top: 0.5rem;\r\n        margin-bottom: 0.5rem;\r\n        margin-left: 0;\r\n        margin-right: 0;\r\n        font-weight: bold;\r\n        text-align: center;\r\n        flex-wrap: nowrap;\r\n        width:100%;\r\n        height:2.3rem;\r\n    }\r\n\r\n    .navButtonDiv{\r\n        display:flex;\r\n        flex-wrap: nowrap;\r\n        width:100%;\r\n\r\n    }\r\n    .navButton{\r\n        border: none;\r\n        font-size: 1.7rem;\r\n        width: 50%;\r\n        background-color: rgb(235, 235, 235);\r\n        color: rgb(0, 0, 0);\r\n        cursor: pointer;\r\n    }\r\n\r\n    .navButtonDark{\r\n        border: none;\r\n        font-size: 1.7rem;\r\n        width: 50%;\r\n        /* background-color: #e7e7e7; */\r\n        background-color: rgb(32, 32, 32);\r\n        color: rgb(173, 173, 173);\r\n        cursor:pointer;\r\n    }\r\n\r\n    @media (hover: hover) {\r\n        .navButton:hover {\r\n            background-color: rgb(202, 202, 202);\r\n            /* background-color: rgb(241, 241, 241); */\r\n        }\r\n        .navButtonDark:hover{\r\n            background-color: rgb(47, 47, 47);\r\n        }\r\n    }\r\n\r\n    \r\n\r\n    .navButtonDivider{\r\n        width:min-content;\r\n        vertical-align:text-top;\r\n    }\r\n\r\n    .bookTitleClass {\r\n        font-size:1.5rem;\r\n        margin-left: 0;\r\n        margin-right: 2rem;\r\n        font-weight: bold;\r\n        flex-shrink: 0;\r\n        align-self: flex-end;\r\n    }\r\n    \r\n    .autoGeneratedChaptersGroup{\r\n        display: flex;\r\n        flex-wrap: wrap;\r\n        font-size: 1.4rem;\r\n        margin-top: 0rem;\r\n        margin-bottom: 0rem;\r\n        margin-left: 0;\r\n        margin-right: 0;\r\n        font-weight: bold;\r\n        line-height: 150%;\r\n    }\r\n    \r\n    #chapterNumber{\r\n        font-size: 1.3rem;\r\n        margin-top: 0rem;\r\n        margin-bottom: 0rem;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .paragraphtitle{\r\n        font-size: 1.2rem;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .versesDivClass{\r\n        /* text-size-adjust: auto; */\r\n        display:flex;\r\n        font-size: 1rem;\r\n        flex-wrap: wrap;\r\n    }\r\n\r\n    #verses{\r\n        margin-top: 0rem;\r\n    }\r\n\r\n    #invisibleBottomForScrolling{\r\n        overflow:visible;\r\n        /* padding-bottom:0px; */\r\n        padding-top:0px;\r\n        margin:0rem;\r\n    }\r\n    \r\n    html {\r\n        scroll-behavior: smooth;\r\n    }\r\n   \r\n</style>\r\n</head>\r\n<body>\r\n\r\n    <div class=\"mainTitleClass\" >\r\n        <span id=\"mainTitle\" class=\"pointer\" onclick=\"showBooks()\">NET Bible<span id=\"showBooks3Bar\" style=\"vertical-align: middle\">&nbsp;≡</span></span>\r\n        <div id=\"textSizeSelectorButtons\">\r\n            <span class=\"pointer\" onclick=\"showSettings()\">\r\n                ...\r\n            </span>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- The chapter div-ing isn't the best probably.-->\r\n    <div class=\"autoGeneratedBooksGroupClass\" >\r\n        <div style=\"display: flex; flex-wrap: wrap;\">\r\n            <div style=\"display: flex; flex-wrap: wrap; margin-right: 0.4rem;\" id=\"autoGeneratedBooksGroup\" ></div></div>\r\n        <div id=\"settings\" style=\"display: none; flex-direction: column; margin-left: auto; margin-right: 1rem; margin-top: 0.4rem; margin-bottom: 1rem; font-size: 1.7rem;  padding-left: 0.4rem; text-align: center;\">\r\n                <div>\r\n                    <span class=\"pointer\" style=\"font-size: 80%;\" onclick=\"decreaseGlobalFont()\">A</span><span>&nbsp;&nbsp;&nbsp;</span><span class=\"pointer\" style=\"font-size: 110%;\" onclick=\"increaseGlobalFont()\">A</span>\r\n                </div>\r\n                <div class=\"pointer\" onclick=\"invertColors()\" style=\"margin-top: 0.7rem;\">\r\n                    <span id=\"invertFirstArrow\"><</span><span id=\"invertSecondArrow\" style=\"background-color: black; color:white;\">></span>\r\n                </div>\r\n            <span id=\"settingsGroup\" ></span>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"buttonGroup\" >\r\n        <div id=\"bookTitle\" class = \"bookTitleClass pointer\" onclick=\"bookClick()\"><span id=\"bookTitleText\"></span></div>\r\n            <div class=\"navButtonDiv\">\r\n                <button class = \"navButton pointer\" id=\"leftButton\" onclick=\"decrementChapter()\" style=\"border-right: 0.1rem solid black;\"><</button>\r\n                <!-- <span class =\"navButtonDivider\">|</span> -->\r\n                <button class = \"navButton pointer\" id=\"rightButton\" onclick=\"incrementChapter()\">></button>\r\n            </div>\r\n    </div>\r\n\r\n    <div class=\"autoGeneratedChaptersGroup\" id=\"autoGeneratedChaptersGroup\"></div>\r\n\r\n    <!-- <p id=\"chapterNumber\"></p> -->\r\n\r\n    <div class=\"versesDivClass\">\r\n        <p id=\"verses\">This site may take a moment to load. If you see this message for more than a few seconds, there is probably an issue with JavaScript. This version of the TinyBible needs a browser with Javascript enabled. Check out TinyBible.org for more information.</p>\r\n    </div>\r\n\r\n    <div class=\"lowerButtonGroup\" id=\"lowerButtons\" style=\"padding-top: 1rem; margin:0px\">\r\n        <div  class=\"navButtonDiv\">\r\n            <button class = \"navButton pointer\" id=\"leftButtonBot\" onclick=\"decrementChapter()\" style=\"border-right: 0.1rem solid black;\"><</button>\r\n            <button class = \"navButton pointer\" id=\"rightButtonBot\" onclick=\"incrementChapter()\">></button>\r\n        </div>\r\n    </div>\r\n    <div id=\"invisibleBottomForScrolling\">\r\n        <!-- <div id=\"infoButton\" style=\"text-align: center; margin:0px;padding-bottom: 1.37rem;\" ><i>All scripture is God-breathed<br><br>NET Translation<br>TinyBible.org - Aug. 2022</i></div> -->\r\n        <div id=\"infoButton\" style=\"text-align: center; margin:0px;padding-bottom: 1.37rem;\" >NET Bible® copyright ©1996, 2019 by Biblical Studies Press, L.L.C. All rights reserved.  <br>TinyBible.org - Sep. 2022</i></div>\r\n    </div>\r\n\r\n    <script>\r\n    let curBook =0;\r\n    let curChapter = 0;\r\n    let showAllChapters = false;\r\n    let curView = 0; const textView = 0; const chaptersView=1; const booksView=2;\r\n    let bookElements =[];\r\n    let chapterElements = [];\r\n\r\n    let showChaptersToggle=false;\r\n    //these keywords are search terms for populating the key arrays.\r\n    let keywordIntro = \"intro\";\r\n    let keywordChapter = \"chapter\"\r\n    let keywordChapterClickableID = \"chapterClickableID\";\r\n    let keywordBookClickableID = \"bookClickableID\";\r\n    \r\n    visualViewport.onresize = function() {setBottomPadding();};\r\n    function setBottomPadding(){document.getElementById('invisibleBottomForScrolling').style.paddingTop= (window.visualViewport.height-document.getElementById('lowerButtons').scrollHeight -document.getElementById('infoButton').offsetHeight) +'px';}\r\n    //const supportsNativeSmoothScroll = 'scroll-behavior' in document.documentElement.style;\r\n    \r\n\r\n    function startUp(){\r\n        \r\n        getBooks();//Only need to run getBooks once on site load. //Donev\r\n        getChapters();//populate the chapters for book[0]\r\n        updateText();//Initializer, to put things on page.\r\n        setBottomPadding();\r\n        scrollToValue(0);\r\n    }\r\n\r\n    //AddingToStringPrototype\r\n    String.prototype.capitalizeFirstLetter = function(){\r\n        if(this.charAt(0)>=0&&this.charAt(0)<=9){\r\n            return this.slice(0,1) + this.charAt(1).toLocaleUpperCase() + this.slice(2);\r\n        }\r\n        else{\r\n            return this.charAt(0).toLocaleUpperCase() + this.slice(1);\r\n        }\r\n    };\r\n\r\n    function bookClick(){\r\n        //console.log(\"TODO: Show chapters\");\r\n        showChaptersToggle?showChaptersToggle=false:showChaptersToggle=true;\r\n        updateChaptersView();\r\n    }\r\n\r\n    function chapterSelectClick(button_id){\r\n        //I'm concerned about returning just the curChapter, incase there isn't an intro... Or maybe even a chapter # jump.\r\n        //So I think I'll search.\r\n\r\n        let tempCurChapter=null;\r\n        //console.log(button_id.replace(keywordChapterClickableID,\"\"));\r\n        \r\n        if(button_id.includes(\"displayAll\")){\r\n            //tempCurChapter='allChapters';//setting to all to handle ch arrow clicks\r\n            showAllChapters=true;\r\n            displayAllChaptersOfCurBook();\r\n        }\r\n        else{\r\n            tempCurChapter=chapterElements.indexOf(( parseInt(button_id.replace(keywordChapterClickableID,\"\")) -1).toString());\r\n            if (tempCurChapter!=null){\r\n                curChapter=tempCurChapter;\r\n                updateText();\r\n            }\r\n        }\r\n    }\r\n\r\n    function bookSelectClick(button_id){\r\n        //set cur book, if different\r\n            //find book\r\n        let tempCurBook = bookElements.indexOf(button_id.replace(keywordBookClickableID,\"\"));\r\n        if(tempCurBook>-1&&tempCurBook!=curBook){\r\n            curBook=tempCurBook;\r\n            curChapter=0;\r\n            getChapters();\r\n            updateText();\r\n            updateChaptersView();\r\n        }\r\n    }\r\n\r\n    function updateText ()  {//updateText is called at the end of page load to instantiate ntb first\r\n        //updateText sets the book Title and the Chapter number (or Introduction), and then populates the current chapter.\r\n        document.getElementById(\"bookTitleText\").innerHTML = bookElements[curBook] + \"<span id=\\\"bookTitle3Bar\\\" style=\\\"vertical-align: middle\\\">&nbsp≡</span>\" ;\r\n        populateChapter();\r\n    }\r\n\r\n\r\n    function showBooks(){\r\n\r\n        let htmlPlaceholderGroupID=\"autoGeneratedBooksGroup\";\r\n\r\n        if(document.getElementById(htmlPlaceholderGroupID).innerHTML.length<2){ //If there's nothing there, show the chapters\r\n\r\n            //Using a's are ok I guess but I changed to span\r\n            let booksFromKeys=\"\";\r\n            let spacing = \"<span>&emsp;<\\/span>\";\r\n            let frontPartOfHTML = \"<span class =\\\"books pointer\\\" id=\\\"\"+keywordBookClickableID;\r\n            let midBackPartOfHTML = \"\\\" onclick=\\\"bookSelectClick(this.id)\\\">\";\r\n            let tailOfHTML = \"<\\/span>\";\r\n\r\n            \r\n                //I like having bookElements b/c can garantee books only.\r\n            bookElements.forEach(element => {\r\n                booksFromKeys+=frontPartOfHTML+element+midBackPartOfHTML+element.replace(\"_\",'').capitalizeFirstLetter() +tailOfHTML+spacing;\r\n                //console.log(booksFromKeys);\r\n            });\r\n            \r\n            document.getElementById(htmlPlaceholderGroupID).innerHTML=booksFromKeys;\r\n            document.getElementById(htmlPlaceholderGroupID).style.marginBottom=\"0.4rem\";\r\n            \r\n        }\r\n        else{//else there is already something there, so hide them. (this is toggling)\r\n            document.getElementById(htmlPlaceholderGroupID).innerHTML=\"\";\r\n            document.getElementById(htmlPlaceholderGroupID).style.marginBottom=\"0rem\";\r\n        }\r\n\r\n    }\r\n\r\n    function updateChaptersView(){\r\n        if(showChaptersToggle){\r\n            \r\n            document.getElementById(\"autoGeneratedChaptersGroup\").style.marginTop = \"1.3rem\";\r\n            document.getElementById(\"autoGeneratedChaptersGroup\").style.marginBottom = \"1rem\";\r\n\r\n            let chaptersFromKeys=\"\";\r\n            let spacing = \"<span>&emsp;<\\/span>\";\r\n            let frontPartOfHTML = \"<span class =\\\"pointer\\\" id=\\\"\"+keywordChapterClickableID;\r\n            let midBackPartOfHTML = \"\\\" onclick=\\\"chapterSelectClick(this.id)\\\">\";\r\n            let tailOfHTML = \"<\\/span>\";\r\n\r\n            getChapters();//it would be great to improve on this. It's not great to need to call things in an order\r\n            //Object.keys(ntb[bookElements[curBook]]); //this is \"chapterElements\"\r\n            chapterElements.forEach(chapterNumbersToPopulate =>{\r\n                  let newChapNumb=(parseInt(chapterNumbersToPopulate)+1).toString();\r\n                 chaptersFromKeys+=frontPartOfHTML+newChapNumb+midBackPartOfHTML+newChapNumb+tailOfHTML+spacing;\r\n                //console.log(chapterNumbersToPopulate);\r\n            })\r\n            chaptersFromKeys+=frontPartOfHTML+'displayAllChapters'+midBackPartOfHTML+'<i>Display&nbsp;All</i>' +tailOfHTML+spacing;\r\n            document.getElementById(\"autoGeneratedChaptersGroup\").innerHTML=chaptersFromKeys;\r\n        }\r\n        else{//else there is already something there, so hide them. (this is toggling)\r\n            document.getElementById(\"autoGeneratedChaptersGroup\").style.marginTop = \"0rem\";\r\n            document.getElementById(\"autoGeneratedChaptersGroup\").style.marginBottom = \"0rem\";\r\n            document.getElementById(\"autoGeneratedChaptersGroup\").innerHTML=\"\";\r\n        }\r\n    }\r\n\r\n    function displayAllChaptersOfCurBook()\r\n    {\r\n        document.getElementById(\"chapterNumber\").innerHTML=\"\";\r\n        let h1regex = /<h1>+/g;\r\n        let trailing_h1regex = /\\/<h1>+/g;\r\n\r\n        //Iterate through the chapters of curBook so the commas aren't put down.\r\n        document.getElementById(\"verses\").innerHTML=\"\";\r\n        ntb[bookElements[curBook]].forEach(chapter => {\r\n            document.getElementById(\"verses\").innerHTML+=chapter.toString().replace(h1regex,'<p id=\"chapterNumber\">').replace(trailing_h1regex, '/p>');\r\n        });\r\n\r\n    }\r\n\r\n    function incrementChapter(){\r\n        if (!showAllChapters && curChapter < chapterElements.length-1){\r\n            curChapter++;\r\n        }\r\n        else{\r\n            showAllChapters=false;\r\n            incrementBook();\r\n            curChapter=0;\r\n            getChapters(); //updates chapter keys array\r\n        }\r\n        updateText();\r\n        scrollToArrows();\r\n    }\r\n\r\n    function decrementChapter(){\r\n        if (!showAllChapters && curChapter>0){\r\n            curChapter--;\r\n        }\r\n        else{\r\n            showAllChapters=false;\r\n            decrementBook();\r\n            getChapters();\r\n            curChapter = chapterElements.length-1;\r\n\r\n        }\r\n        updateText();\r\n        scrollToArrows();\r\n    }\r\n\r\n    function incrementBook(){\r\n        if (curBook < bookElements.length-1){\r\n            curBook++;\r\n        }\r\n        else{\r\n            curBook=0;\r\n        }\r\n        updateChaptersView();\r\n    }\r\n\r\n    function decrementBook(){\r\n        if (curBook>0){\r\n            curBook--;\r\n        }\r\n        else{\r\n            curBook=bookElements.length-1;\r\n        }\r\n        updateChaptersView();\r\n    }\r\n\r\n    function populateChapter(){\r\n        let h1regex = /<h1>+/g;\r\n        let trailing_h1regex = /\\/<h1>+/g;\r\n        document.getElementById(\"verses\").innerHTML = ntb[bookElements[curBook]][curChapter].replace(h1regex,'<p id=\"chapterNumber\">').replace(trailing_h1regex, '/p>'); \r\n        //These replaces remove the h1 divs around the book/chapter nubmers.\r\n    }\r\n    \r\n\r\n    function getChapters() {\r\n        //This fn may be able to be removed. It's almost like, the NET format isn't as critical\r\n       chapterElements= Object.keys(ntb[bookElements[curBook]]);\r\n    }\r\n\r\n    function getBooks(){\r\n        bookElements = Object.keys(ntb);\r\n    }\r\n\r\n    document.onkeydown = function(evt) {\r\n        evt = evt || window.event;\r\n        if (evt.keyCode == 37) {\r\n            decrementChapter();\r\n            //left arrow\r\n            return;\r\n        }\r\n        else if (evt.keyCode == 39) {\r\n            incrementChapter();\r\n            //right arrow\r\n            return;\r\n        }\r\n        else if (evt.key == \"+\") {\r\n            increaseGlobalFont();\r\n            //plus sign\r\n        }\r\n        else if (evt.key == \"-\") {\r\n            decreaseGlobalFont();\r\n            //minus sign\r\n        }\r\n    }\r\n\r\n    function scrollToValue(scrollToVal) {\r\n            //There's a global css for smooth scrolling\r\n            setTimeout(() => {window.scroll(0,scrollToVal);}, 0);\r\n            }\r\n\r\n    function scrollToArrows() {\r\n        let scrollToArrowsAmount=document.getElementById('leftButton').offsetTop - 10;\r\n\r\n        scrollToValue(scrollToArrowsAmount);\r\n    }\r\n\r\n    let colorsInverted = false;\r\n    function invertColors(){\r\n        if (!colorsInverted){\r\n            colorsInverted=true;\r\n            document.documentElement.style.backgroundColor=\"black\";\r\n            document.documentElement.style.color=\"rgb(241, 241, 241)\";\r\n            document.getElementById(\"leftButton\").className=\"navButtonDark\";\r\n            document.getElementById(\"rightButton\").className=\"navButtonDark\";\r\n            document.getElementById(\"leftButtonBot\").className=\"navButtonDark\";\r\n            document.getElementById(\"rightButtonBot\").className=\"navButtonDark\";\r\n            document.getElementById(\"invertSecondArrow\").style.backgroundColor=\"white\";\r\n            document.getElementById(\"invertSecondArrow\").style.color=\"black\";\r\n\r\n        }\r\n        else{\r\n            colorsInverted=false;\r\n            document.documentElement.style.backgroundColor=\"white\";\r\n            document.documentElement.style.color=\"black\";\r\n            document.getElementById(\"leftButton\").className=\"navButton\";\r\n            document.getElementById(\"rightButton\").className=\"navButton\";\r\n            document.getElementById(\"leftButtonBot\").className=\"navButton\";\r\n            document.getElementById(\"rightButtonBot\").className=\"navButton\";\r\n            document.getElementById(\"invertSecondArrow\").style.backgroundColor=\"black\";\r\n            document.getElementById(\"invertSecondArrow\").style.color=\"white\";\r\n\r\n        }\r\n    }\r\n\r\n    let couldMakeThisBetterDisplaySettings = false;\r\n    function showSettings(){\r\n        if(!couldMakeThisBetterDisplaySettings){\r\n            document.getElementById(\"settings\").style.display=\"flex\";\r\n            couldMakeThisBetterDisplaySettings=true;\r\n        }\r\n        else{\r\n            document.getElementById(\"settings\").style.display=\"none\";\r\n            couldMakeThisBetterDisplaySettings=false;\r\n        }\r\n    }\r\n\r\n    function decreaseGlobalFont(){\r\n\r\n        let fontSizz =  parseInt(document.documentElement.style.fontSize);\r\n        //console.log(fontSizz);\r\n\r\n        if(Number.isNaN(fontSizz)){\r\n            document.documentElement.style.fontSize=90+'%';\r\n        }\r\n        else{\r\n            fontSizz-=10;\r\n            document.documentElement.style.fontSize=fontSizz+'%';\r\n        }\r\n        setBottomPadding();\r\n    }\r\n    function increaseGlobalFont(){\r\n        let fontSizz =  parseInt(document.documentElement.style.fontSize);\r\n        //console.log(fontSizz);\r\n\r\n        if(Number.isNaN(fontSizz)){\r\n            document.documentElement.style.fontSize=110+'%';\r\n        }\r\n        else{\r\n            fontSizz+=10;\r\n            document.documentElement.style.fontSize=fontSizz+'%';\r\n        }\r\n        setBottomPadding();\r\n    }\r\n\r\n    async function deeeeeCompress()\r\n    {\r\n        zip.configure({\r\n        useWebWorkers: false\r\n        });\r\n\r\n        //Create a reader for the zip\r\n        const reader = new zip.ZipReader(new zip.Data64URIReader(ntbComped));\r\n\r\n        // get all entries from the zip\r\n        const entries = await reader.getEntries();\r\n\r\n        if (entries.length) \r\n        {\r\n\r\n            // get first entry content as text by using a TextWriter\r\n            const text = await entries[0].getData(new zip.TextWriter());\r\n            // text contains the entry data as a String\r\n            console.log(\"Finished decompresion\");\r\n            ntb = JSON.parse(text);\r\n\r\n        }\r\n\r\n        // close the ZipReader\r\n        await reader.close();\r\n\r\n        startUp();\r\n    }\r\n\r\n    //Zip.jsNoWorkerMinInflate\r\n    !function(e,t){\"object\"==typeof exports&&\"undefined\"!=typeof module?t(exports):\"function\"==typeof define&&define.amd?define([\"exports\"],t):t((e=\"undefined\"!=typeof globalT